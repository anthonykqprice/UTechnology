 "framework": {
  "implementation": "One Java base class (WorkableElectricMultiblockMachine underneath) holding all pattern, segment-count, frame and module logic, per CLAUDE.md, so the GTM 8.0 pattern migration touches one place.",
  "structure": {
   "shape": "3 wide, 3 tall. Length is 1 front aisle + N segments + 1 end aisle.",
   "legend": {
    "X": "controller",
    "H": "frame casing, or a hatch",
    "C": "frame casing only",
    "K": "the machine's core block (specific to each machine type)",
    "F": "frame box of the frame material (e.g. gtceu:steel_frame)"
   },
   "aisles": {
    "front": [
     "HHH",
     "HXH",
     "HHH"
    ],
    "segment": [
     "CCC",
     "CKC",
     "CCC"
    ],
    "end": [
     "FHF",
     "HHH",
     "FHF"
    ]
   },
   "spike_rule": "GTM double-counts limited hatches in the aisle right after a repeatable aisle unless that aisle's first checked block differs from the segment's. The end aisle's corners are frame boxes, not casings, so its first checked block always differs. Required GameTest: limited hatches in the end aisle form correctly at every length from 1 to the largest cap.",
   "max_segments_built": 32
  },
  "hatches": {
   "positions": "Any H. Front and end aisles together offer 15 positions.",
   "limits": {
    "maintenance": {
     "min": 1,
     "max": 1,
     "note": "required while GTM maintenance is enabled"
    },
    "energy_input": {
     "min": 1,
     "max": 2
    },
    "item_input_bus": {
     "min": 1,
     "max": 6
    },
    "item_output_bus": {
     "min": 1,
     "max": 2
    },
    "fluid_input_hatch": {
     "min": 0,
     "max": 2,
     "note": "every machine accepts them",
     "so a batch bus can get lubricant": null
    },
    "fluid_output_hatch": {
     "min": 0,
     "max": 1,
     "only_if": "machine outputs fluids"
    }
   },
   "voltage": "The machine's max voltage is capped at its frame's max_voltage, whatever its energy hatches are. This also overrides GTM's \"two hatches give one tier more\" rule, which stays in reserve as a deliberate gate (see the component-voltage decision in slice1-mechanical.yaml).",
